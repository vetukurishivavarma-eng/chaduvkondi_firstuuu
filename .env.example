# Database (Neon PostgreSQL - get from https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/chaduvkondi-db?sslmode=require"

# Auth - Generate a random 32+ char string
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# Email (Resend - get from https://resend.com/api-keys)
# Optional in dev mode - password reset links will be logged to console
RESEND_API_KEY=""
# Optional - defaults to onboarding@resend.dev which works without verification
# In production, verify your domain and set this to your verified sender
RESEND_FROM_EMAIL="Chaduvkondi <noreply@yourdomain.com>"

# App URL (for Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
