generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  learner
  admin
}

enum ResourceType {
  video
  article
  documentation
  interactive
}

enum QuizType {
  diagnostic
  practice
  spaced_repetition
  code_challenge
  speed_test
}

enum UserMood {
  chill
  excited
  focused
  tired
  goofy
  sleepy
  hungry
  grumpy
  anxious
  confident
}

enum BadgeCategory {
  mastery
  streak
  quiz
  social
  special
}

enum ProblemDifficulty {
  easy
  medium
  hard
  expert
}

enum ProblemStatus {
  draft
  published
  archived
}

enum InterviewType {
  coding
  mcq
  sql
  debugging
  output_prediction
  lld
  system_design
}

enum InterviewStatus {
  pending
  in_progress
  completed
  evaluated
}

enum ContestStatus {
  upcoming
  active
  completed
}

enum SubmissionStatus {
  pending
  compiling
  running
  accepted
  wrong_answer
  time_limit_exceeded
  memory_limit_exceeded
  runtime_error
  compilation_error
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(learner)
  bio       String   @default("")
  tierId           String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  avatarUrl          String?
  avatarCreatedAt    DateTime?
  avatarShirtColor   String   @default("#3D5A45")
  avatarPantsColor   String   @default("#2D4635")
  avatarHairColor    String   @default("#4A3728")
  avatarSkinColor    String   @default("#E8C4A0")
  mood               UserMood @default(chill)
  currentTrackId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tier              TierDefinition?    @relation(fields: [tierId], references: [id])
  currentTrack      Track?             @relation(fields: [currentTrackId], references: [id])
  quizAttempts      QuizAttempt[]
  masteryScores     MasteryScore[]
  leaderboardSnaps  LeaderboardSnapshot[]
  spacedRepetitions SpacedRepetition[]
  badges            UserBadge[]
  followers         Follow[]          @relation("following")
  following         Follow[]          @relation("follower")
  challengeSubmissions ChallengeSubmission[]
  dailyChallenges       UserDailyChallenge[]
  seasonScores          UserSeasonScore[]
  battlesInitiated     Battle[]   @relation("challenger")
  battlesReceived      Battle[]   @relation("opponent")
  battleAnswers        BattleAnswer[]
  battlePoints         Int        @default(0)
  battleWins           Int        @default(0)
  battleLosses         Int        @default(0)
  battleDraws          Int        @default(0)

  // Coding Interview Platform
  authoredProblems     CodingProblem[]     @relation("ProblemAuthor")
  approvedProblems     CodingProblem[]     @relation("ProblemApprover")
  problemSubmissions   ProblemSubmission[]
  problemBookmarks     ProblemBookmark[]
  problemProgress      UserProblemProgress[]
  mockInterviews       MockInterview[]
  contestRegistrations ContestRegistration[]
  contestRankings      ContestRanking[]
  createdContests      Contest[]            @relation("ContestCreator")
}

model Track {
  id          String @id @default(cuid())
  name        String @unique
  description String
  longDescription String @default("")
  icon        String @default("📚")
  color       String @default("#6366f1")
  difficulty  String @default("Beginner")
  popularity  Int    @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  subDomains  SubDomain[]
  users       User[]
  quizAttempts QuizAttempt[]
  battles     Battle[]
}

model SubDomain {
  id          String @id @default(cuid())
  name        String
  description String
  trackId     String
  order       Int    @default(0)
  createdAt   DateTime @default(now())

  track     Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  concepts  Concept[]
}

model Concept {
  id          String @id @default(cuid())
  name        String
  description String
  subDomainId String
  order       Int    @default(0)
  createdAt   DateTime @default(now())

  subDomain         SubDomain           @relation(fields: [subDomainId], references: [id], onDelete: Cascade)
  questions         Question[]
  resources         Resource[]
  masteryScores     MasteryScore[]
  spacedRepetitions SpacedRepetition[]
  codeChallenges    CodeChallenge[]
}

model Question {
  id               String  @id @default(cuid())
  text             String
  codeSnippet      String  @default("")
  conceptId        String
  difficultyWeight Float   @default(1.0)
  explanation      String
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  concept        Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  choices        Choice[]
  answerLogs     AnswerLog[]
  battleQuestions BattleQuestion[]
}

model Choice {
  id         String @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  questionId String

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerLogs AnswerLog[]
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String
  url         String
  type        ResourceType @default(video)
  conceptId   String
  createdAt   DateTime     @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  trackId     String?
  type        QuizType @default(practice)
  score       Float?
  totalWeight Float?
  completed   Boolean  @default(false)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      Track?      @relation(fields: [trackId], references: [id])
  answerLogs AnswerLog[]
}

model AnswerLog {
  id            String   @id @default(cuid())
  quizAttemptId String
  questionId    String
  choiceId      String
  isCorrect     Boolean
  timeSpent     Int?
  createdAt     DateTime @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice      Choice      @relation(fields: [choiceId], references: [id], onDelete: Cascade)
}

model MasteryScore {
  id           String   @id @default(cuid())
  userId       String
  conceptId    String
  score        Float    @default(0.0)
  attempts     Int      @default(0)
  correctCount Int      @default(0)
  lastTestedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
}

model TierDefinition {
  id        String @id @default(cuid())
  name      String @unique
  minScore  Float
  color     String @default("#6366f1")
  icon      String @default("⭐")
  createdAt DateTime @default(now())

  users  User[]
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  userId    String
  score     Float
  rank      Int
  period    String   @default("weekly")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpacedRepetition {
  id           String   @id @default(cuid())
  userId       String
  conceptId    String
  interval     Int      @default(1)
  easeFactor   Float    @default(2.5)
  nextReviewAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
}

model Badge {
  id          String         @id @default(cuid())
  name        String         @unique
  description String
  icon        String         @default("🏆")
  color       String         @default("#F59E0B")
  category    BadgeCategory  @default(mastery)
  criteria    String         @default("")
  maxProgress Int            @default(1)
  createdAt   DateTime       @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  progress  Int      @default(0)
  earned    Boolean  @default(false)
  earnedAt  DateTime?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model CodeChallenge {
  id              String   @id @default(cuid())
  title           String
  description     String
  difficulty      String   @default("easy")
  templateCode    String   @default("")
  solutionCode    String   @default("")
  testCases       String   @default("[]")
  language        String   @default("python")
  conceptId       String
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  concept       Concept                @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  submissions   ChallengeSubmission[]
}

model ChallengeSubmission {
  id              String   @id @default(cuid())
  userId          String
  challengeId     String
  code            String
  passed          Boolean  @default(false)
  score           Float?   @default(0)
  executionTimeMs Int?
  createdAt       DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @unique // date-only (normalized to midnight)
  title       String
  description String
  type        String   @default("quiz") // quiz, perfect_score, streak, concepts
  target      Int      @default(5) // e.g., answer 5 questions
  reward      Int      @default(50) // bonus XP or points
  icon        String   @default("🎯")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userProgress UserDailyChallenge[]
}

model UserDailyChallenge {
  id           String   @id @default(cuid())
  userId       String
  challengeId  String
  progress     Int      @default(0)
  completed    Boolean  @default(false)
  claimed      Boolean  @default(false)
  completedAt  DateTime?
  claimedAt    DateTime?
  createdAt    DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model LeaderboardSeason {
  id          String   @id @default(cuid())
  name        String   @unique
  period      String   @default("weekly") // weekly, monthly
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  isFinished  Boolean  @default(false)
  createdAt   DateTime @default(now())

  userScores  UserSeasonScore[]
}

model Battle {
  id              String   @id @default(cuid())
  challengerId    String
  opponentId      String
  trackId         String
  status          String   @default("pending") // pending, ready, active, completed, declined
  challengerScore Float    @default(0)
  opponentScore   Float    @default(0)
  currentQuestion Int      @default(0)
  readyChallenger Boolean  @default(false)
  readyOpponent   Boolean  @default(false)
  questionCount   Int      @default(10)
  isAi            Boolean  @default(false)
  aiDifficulty    String   @default("easy") // easy, medium, hard
  aiCeoName       String   @default("") // CEO persona name
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  challenger   User            @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent     User            @relation("opponent", fields: [opponentId], references: [id], onDelete: Cascade)
  track        Track           @relation(fields: [trackId], references: [id])
  questions    BattleQuestion[]
  answers      BattleAnswer[]

  @@index([challengerId])
  @@index([opponentId])
}

model BattleQuestion {
  id         String   @id @default(cuid())
  battleId   String
  questionId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  battle   Battle         @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id])
  answers  BattleAnswer[]

  @@unique([battleId, questionId])
}

model BattleAnswer {
  id         String   @id @default(cuid())
  battleId   String
  battleQuestionId String
  userId     String
  choiceId   String
  isCorrect  Boolean
  points     Int      @default(0)
  answeredAt DateTime @default(now())

  battle        Battle         @relation(fields: [battleId], references: [id], onDelete: Cascade)
  battleQuestion BattleQuestion @relation(fields: [battleQuestionId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleQuestionId, userId])
}

model UserSeasonScore {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  score     Float    @default(0)
  rank      Int?
  quizzes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  season  LeaderboardSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
}

// ═══════════════════════════════════════════════════════════════════
// CODING INTERVIEW PLATFORM — New Models (Phase 1)
// ═══════════════════════════════════════════════════════════════════

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  logoUrl     String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems      CodingProblem[]
  tags          CompanyTag[]
  mockInterviews MockInterview[]
}

model ProgrammingLanguage {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  extension String   @default("")
  monacoId  String   @default("")
  judge0Id  Int?
  pistonId  String   @default("")
  icon      String   @default("\ud83d\udcc4")
  color     String   @default("#6366f1")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  problems    CodingProblem[]
  submissions ProblemSubmission[]
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  icon        String   @default("\ud83d\udcda")
  color       String   @default("#6366f1")
  parentId    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Topic?          @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[]         @relation("TopicHierarchy")
  problems CodingProblem[]
  tags     CompanyTag[]
}

model CompanyTag {
  id        String @id @default(cuid())
  companyId String
  topicId   String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([companyId, topicId])
}

model CodingProblem {
  id              String            @id @default(cuid())
  title           String            @unique
  slug            String            @unique
  difficulty      ProblemDifficulty @default(easy)

  story              String @default("")
  problemStatement   String
  inputFormat        String @default("")
  outputFormat       String @default("")
  constraints        String @default("")
  examples           String @default("[]")
  edgeCases          String @default("[]")
  hints              String @default("[]")

  bruteForceSolution  String @default("")
  optimalSolution     String @default("")
  complexityAnalysis  String @default("")
  dryRun              String @default("")
  flowDiagramUrl      String?
  pseudoCode          String @default("")

  solutionJava       String @default("")
  solutionPython     String @default("")
  solutionCpp        String @default("")
  solutionC          String @default("")
  solutionJavaScript String @default("")
  solutionGo         String @default("")
  solutionRust       String @default("")
  solutionKotlin     String @default("")
  solutionSwift      String @default("")
  solutionPhp        String @default("")
  solutionCsharp     String @default("")
  solutionRuby       String @default("")
  solutionTypescript String @default("")

  interviewTips     String @default("")
  commonMistakes    String @default("")

  testCases          String @default("[]")
  hiddenTestCases    String @default("[]")

  tags              String        @default("[]")
  totalSubmissions  Int           @default(0)
  totalAccepted     Int           @default(0)
  acceptanceRate    Float         @default(0.0)
  isAiGenerated     Boolean       @default(false)
  status            ProblemStatus @default(published)
  upvotes           Int           @default(0)
  downvotes         Int           @default(0)

  authorId     String?
  companyId    String?
  languageId   String
  topicId      String?
  createdById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User?               @relation("ProblemAuthor", fields: [authorId], references: [id])
  company     Company?            @relation(fields: [companyId], references: [id])
  language    ProgrammingLanguage @relation(fields: [languageId], references: [id])
  topic       Topic?              @relation(fields: [topicId], references: [id])
  createdBy   User?               @relation("ProblemApprover", fields: [createdById], references: [id])

  submissions     ProblemSubmission[]
  bookmarks       ProblemBookmark[]
  userProgress    UserProblemProgress[]
  interviewProblems InterviewProblem[]
  contestProblems ContestProblem[]

  @@index([difficulty])
  @@index([companyId])
  @@index([languageId])
  @@index([topicId])
  @@index([status])
  @@index([createdAt])
}

model ProblemSubmission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  languageId      String
  code            String
  status          SubmissionStatus @default(pending)
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  executionTimeMs Int?
  memoryUsedKb    Int?
  errorMessage    String?
  score           Float?
  createdAt       DateTime         @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  CodingProblem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language ProgrammingLanguage @relation(fields: [languageId], references: [id])

  @@index([userId, problemId])
  @@index([problemId, status])
  @@index([userId, createdAt])
}

model ProblemBookmark {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model UserProblemProgress {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  attempts     Int      @default(0)
  solved       Boolean  @default(false)
  lastSolvedAt DateTime?
  bestCode     String   @default("")
  bestScore    Float?
  bookmarked   Boolean  @default(false)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model MockInterview {
  id              String          @id @default(cuid())
  userId          String
  title           String          @default("")
  companyId       String?
  experienceYears Float           @default(2)
  durationMinutes Int             @default(60)
  status          InterviewStatus @default(pending)
  score           Float?
  feedback        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?             @relation(fields: [companyId], references: [id])
  problems  InterviewProblem[]
  questions InterviewQuestion[]
}

model InterviewProblem {
  id          String   @id @default(cuid())
  interviewId String
  problemId   String
  order       Int      @default(0)
  userCode    String   @default("")
  score       Float?
  feedback    String?
  solved      Boolean  @default(false)

  interview MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  problem   CodingProblem @relation(fields: [problemId], references: [id])
}

model InterviewQuestion {
  id           String        @id @default(cuid())
  interviewId  String
  questionText String
  type         InterviewType @default(mcq)
  choices      String        @default("[]")
  correctAnswer String       @default("")
  userAnswer   String        @default("")
  isCorrect    Boolean?
  explanation  String        @default("")
  score        Float?
  order        Int           @default(0)

  interview MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model Contest {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  startTime   DateTime
  endTime     DateTime
  duration    Int
  status      ContestStatus @default(upcoming)
  isVirtual   Boolean       @default(false)
  rules       String        @default("")
  prizes      String        @default("")
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy     User                  @relation("ContestCreator", fields: [createdById], references: [id])
  problems      ContestProblem[]
  registrations ContestRegistration[]
  rankings      ContestRanking[]

  @@index([status])
  @@index([startTime])
}

model ContestProblem {
  id         String @id @default(cuid())
  contestId  String
  problemId  String
  order      Int    @default(0)
  points     Int    @default(100)

  contest Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id])

  @@unique([contestId, problemId])
}

model ContestRegistration {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model ContestRanking {
  id             String   @id @default(cuid())
  contestId      String
  userId         String
  score          Int      @default(0)
  rank           Int?
  problemsSolved Int      @default(0)
  totalTime      Int      @default(0)
  finishedAt     DateTime?

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model AiGenerationLog {
  id             String   @id @default(cuid())
  prompt         String
  response       String
  model          String   @default("gpt-4")
  tokensUsed     Int      @default(0)
  generationType String   @default("problem")
  createdAt      DateTime @default(now())
}
